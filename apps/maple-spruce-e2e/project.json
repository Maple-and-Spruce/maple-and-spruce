{
  "name": "maple-spruce-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/maple-spruce-e2e/src",
  "projectType": "application",
  "tags": ["scope:maple-spruce", "type:e2e"],
  "implicitDependencies": ["maple-spruce", "firebase-integration-test-utils"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/maple-spruce-e2e",
        "command": "playwright test"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/maple-spruce-e2e",
        "command": "eslint ."
      },
      "metadata": {
        "technologies": ["eslint"]
      }
    }
  }
}
