    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "../../libs/firebase/maple-functions/calendar-classes-feed/**/*.ts",
    "../../libs/firebase/maple-functions/calendar-music-feed/**/*.ts",
