rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // All writes go through Cloud Functions (admin SDK bypasses rules), so
    // clients never write directly. Only the image paths Webflow renders are
    // publicly readable; everything else is server-only.

    match /artists/{allPaths=**} {
      allow read: if true;
    }

    match /classes/{allPaths=**} {
      allow read: if true;
    }

    match /instructors/{allPaths=**} {
      allow read: if true;
    }

    // Class category gallery pool (referenced by classes pulled into Webflow)
    match /categories/{allPaths=**} {
      allow read: if true;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
