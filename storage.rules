rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Artist, class, and instructor photos are publicly readable (for Webflow integration)
    match /artists/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /classes/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /instructors/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Class category gallery pool — publicly readable (referenced by classes pulled into Webflow)
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default: authenticated access only
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
